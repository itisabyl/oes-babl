#!/usr/bin/env bash
set -Eeuo pipefail

die() { printf 'oes-babl: %s\n' "$*" >&2; exit 1; }

saved_size=
size_file=${XDG_CONFIG_HOME:-$HOME/.config}/oes-babl/screen-size
if [[ -r $size_file ]]; then
    IFS= read -r saved_size < "$size_file" || true
fi
[[ $saved_size =~ ^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$ ]] || saved_size=1920x1080
size=${OES_BABL_SIZE:-$saved_size}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    printf '%s\n' \
        'Использование: oes-babl [URL]' \
        'Открывает Chrome с обычными профилями на виртуальном экране.' \
        'Экран — на весь монитор; Chrome — с вкладками и адресной строкой.' \
        'Сайт по умолчанию: https://lms.astanait.edu.kz' \
        'Перед запуском полностью выйдите из обычного Chrome.' \
        "Размер экрана: $size (сохранённый при установке: $saved_size)." \
        'Другой размер: OES_BABL_SIZE=1920x1080 oes-babl' \
        'Раскладки клавиатуры: OES_BABL_LAYOUT=us,ru,kz oes-babl' \
        'Профиль (необязательно): CHROME_PROFILE="Profile 1" oes-babl'
    exit 0
fi

for dependency in Xephyr openbox xauth xprop mcookie flock; do
    command -v "$dependency" >/dev/null || die "Не найдена программа: $dependency"
done
browser=$(command -v google-chrome-stable || command -v google-chrome || true)
[[ -n $browser ]] || die 'Google Chrome не найден.'
[[ -n ${DISPLAY:-} ]] || die 'Нет DISPLAY. Для Xephyr нужен работающий Xwayland (например, встроенный в KDE/GNOME или xwayland-satellite в niri).'

[[ $size =~ ^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$ ]] || die 'Размер должен иметь вид 1920x1080.'
profile_root=${CHROME_USER_DATA_DIR:-${CHROME_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/google-chrome}
[[ -d $profile_root ]] || die "Не найден каталог существующего Chrome: $profile_root"

if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && -w $XDG_RUNTIME_DIR ]]; then
    runtime_dir=$XDG_RUNTIME_DIR/oes-babl
    mkdir -p -m 700 "$runtime_dir"
else
    runtime_dir=/tmp/oes-babl-$UID
    mkdir -p -m 700 "$runtime_dir"
    [[ -O $runtime_dir ]] || die "Небезопасный владелец каталога блокировки: $runtime_dir"
    chmod 700 "$runtime_dir"
fi
exec 9>"$runtime_dir/lock"
flock -n 9 || die 'Виртуальный экран уже запущен.'
lock_target=$(readlink "$profile_root/SingletonLock" 2>/dev/null || true)
lock_pid=${lock_target##*-}
if [[ $lock_pid =~ ^[0-9]+$ ]] && kill -0 "$lock_pid" 2>/dev/null; then
    if [[ ! -r /proc/$lock_pid/cmdline ]] || grep -zqi 'chrome' "/proc/$lock_pid/cmdline" 2>/dev/null; then
        die 'Chrome уже работает. Сохраните работу, выберите в Chrome меню ⋮ → Выход и запустите oes-babl снова.'
    fi
fi

display_number=
for candidate in {99..119}; do
    if [[ ! -e /tmp/.X11-unix/X$candidate && ! -e /tmp/.X$candidate-lock ]]; then
        display_number=$candidate
        break
    fi
done
[[ -n $display_number ]] || die 'Нет свободного номера виртуального экрана (99–119).'
virtual_display=:$display_number
session_dir=$(mktemp -d "$runtime_dir/session.XXXXXXXX")
auth_file=$session_dir/Xauthority
xephyr_pid= wm_pid= chrome_pid=

cleanup() {
    trap - EXIT INT TERM HUP
    if [[ -n $chrome_pid ]] && kill -0 "$chrome_pid" 2>/dev/null; then
        kill -TERM "$chrome_pid" 2>/dev/null || true
        for ((attempt=0; attempt<50; attempt++)); do
            kill -0 "$chrome_pid" 2>/dev/null || break
            sleep 0.1
        done
        kill -0 "$chrome_pid" 2>/dev/null && kill -KILL "$chrome_pid" 2>/dev/null || true
    fi
    if [[ -n $wm_pid ]]; then
        kill "$wm_pid" 2>/dev/null || true
        wait "$wm_pid" 2>/dev/null || true
    fi
    if [[ -n $xephyr_pid ]]; then
        kill "$xephyr_pid" 2>/dev/null || true
        wait "$xephyr_pid" 2>/dev/null || true
    fi
    rm -rf -- "$session_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

xkb_layout=${OES_BABL_LAYOUT:-}
kxkbrc=${XDG_CONFIG_HOME:-$HOME/.config}/kxkbrc
if [[ -z $xkb_layout && -r $kxkbrc ]]; then
    xkb_layout=$(awk -F= '$1 == "LayoutList" { print $2; exit }' "$kxkbrc" 2>/dev/null || true)
fi
if [[ -z $xkb_layout ]]; then
    host_xkb=$(xprop -root _XKB_RULES_NAMES 2>/dev/null | awk -F'"' '{ print $6 }' || true)
    [[ $host_xkb == *,* ]] && xkb_layout=$host_xkb
fi
[[ $xkb_layout =~ ^[a-zA-Z0-9_,]+$ ]] || xkb_layout=us,ru
xkb_options=${OES_BABL_XKB_OPTIONS:-grp:alt_shift_toggle}
[[ $xkb_options =~ ^[a-zA-Z0-9_,:+-]+$ ]] || xkb_options=grp:alt_shift_toggle

touch "$auth_file"
chmod 600 "$auth_file"
xauth -f "$auth_file" add "$virtual_display" MIT-MAGIC-COOKIE-1 "$(mcookie)"
Xephyr "$virtual_display" -screen "$size" -fullscreen -nolisten tcp -noreset \
    -no-host-grab -title "oes-babl" \
    -xkb-layout "$xkb_layout" -xkb-options "$xkb_options" \
    -auth "$auth_file" >"$session_dir/xephyr.log" 2>&1 9>&- &
xephyr_pid=$!

ready=false
for ((attempt=0; attempt<100; attempt++)); do
    if ! kill -0 "$xephyr_pid" 2>/dev/null; then
        cat "$session_dir/xephyr.log" >&2
        die 'Не удалось открыть Xephyr.'
    fi
    if [[ -S /tmp/.X11-unix/X$display_number ]] &&
        DISPLAY="$virtual_display" XAUTHORITY="$auth_file" xprop -root >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 0.1
done
if [[ $ready != true ]]; then
    cat "$session_dir/xephyr.log" >&2
    die 'Xephyr не запустился за 10 секунд.'
fi

env -u WAYLAND_DISPLAY DISPLAY="$virtual_display" XAUTHORITY="$auth_file" \
    XDG_SESSION_TYPE=x11 openbox >"$session_dir/openbox.log" 2>&1 9>&- &
wm_pid=$!

# Wait for the window manager so Chrome can request maximization reliably.
ready=false
for ((attempt=0; attempt<100; attempt++)); do
    if ! kill -0 "$wm_pid" 2>/dev/null; then
        cat "$session_dir/openbox.log" >&2
        die 'Не удалось запустить Openbox.'
    fi
    wm_state=$(DISPLAY="$virtual_display" XAUTHORITY="$auth_file" \
        xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null || true)
    if [[ $wm_state == *'window id # '* ]]; then
        ready=true
        break
    fi
    sleep 0.1
done
if [[ $ready != true ]]; then
    cat "$session_dir/openbox.log" >&2
    die 'Openbox не запустился за 10 секунд.'
fi

chrome_args=(--ozone-platform=x11 --disable-background-mode "--user-data-dir=$profile_root" --start-maximized)
[[ -z ${CHROME_PROFILE:-} ]] || chrome_args+=("--profile-directory=$CHROME_PROFILE")
if (( $# == 0 )); then
    set -- https://lms.astanait.edu.kz
fi
printf 'oes-babl: экран %s (%s). Закройте Chrome, чтобы завершить.\n' "$virtual_display" "$size"
printf '%s\n' 'Перед записью всего экрана проверьте предпросмотр на сайте.'
env -u WAYLAND_DISPLAY DISPLAY="$virtual_display" XAUTHORITY="$auth_file" \
    XDG_SESSION_TYPE=x11 "$browser" "${chrome_args[@]}" "$@" 9>&- &
chrome_pid=$!
wait "$chrome_pid"
