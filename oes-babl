#!/usr/bin/env bash
set -Eeuo pipefail

die() { printf 'oes-babl: %s\n' "$*" >&2; exit 1; }

valid_size() { [[ ${1:-} =~ ^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$ ]]; }

detect_size() {
    local detected=
    # Prefer niri's physical mode: Xwayland may report a scaled logical size.
    if command -v niri >/dev/null && command -v python3 >/dev/null; then
        detected=$(niri msg --json focused-output 2>/dev/null | python3 -c '
import json, sys
try:
    output = json.load(sys.stdin)
    mode = output["modes"][output["current_mode"]]
    width, height = mode["width"], mode["height"]
    transform = output.get("logical", {}).get("transform", "Normal")
    if transform in ("90", "270", "Flipped90", "Flipped270"):
        width, height = height, width
    print(f"{width}x{height}")
except (ValueError, KeyError, TypeError, IndexError, AttributeError):
    sys.exit(1)
' 2>/dev/null) || detected=
        if valid_size "$detected"; then
            printf '%s\n' "$detected"
            return
        fi
    fi

    # On KDE Plasma (Wayland), query KScreen for the physical mode to avoid Xwayland scaling.
    if command -v kscreen-doctor >/dev/null && command -v python3 >/dev/null; then
        detected=$(kscreen-doctor -j 2>/dev/null | python3 -c '
import json, re, sys
try:
    raw = re.sub(r"\x1b\[[0-9;]*m", "", sys.stdin.read())
    data = json.loads(raw)
    outputs = [
        o for o in data.get("outputs", [])
        if o.get("connected") and o.get("enabled") and o.get("currentModeId") is not None
    ]
    outputs.sort(key=lambda o: (0 if o.get("priority") == 1 else 1, o.get("priority") or 999))
    output = outputs[0]
    mode_id = str(output["currentModeId"])
    mode = next(m for m in output.get("modes", []) if str(m.get("id")) == mode_id)
    width, height = mode["size"]["width"], mode["size"]["height"]
    if output.get("rotation") in (2, 8, "Left", "Right", "90", "270"):
        width, height = height, width
    print(f"{width}x{height}")
except (ValueError, KeyError, TypeError, IndexError, AttributeError, StopIteration):
    sys.exit(1)
' 2>/dev/null) || detected=
        if valid_size "$detected"; then
            printf '%s\n' "$detected"
            return
        fi
    fi

    # On X11, choose the primary active output, or the first active output.
    if command -v xrandr >/dev/null; then
        detected=$(xrandr --query 2>/dev/null | awk '
            $2 == "connected" {
                primary = ($3 == "primary")
                for (i = 3; i <= NF; i++) {
                    if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) {
                        size = $i
                        sub(/[+-].*$/, "", size)
                        if (!first) first = size
                        if (primary) preferred = size
                        break
                    }
                }
            }
            END { if (preferred) print preferred; else if (first) print first }
        ') || detected=
        if valid_size "$detected"; then
            printf '%s\n' "$detected"
            return
        fi
    fi
    return 1
}

resolve_profile_root() {
    [[ ${OES_BABL_STANDALONE:-0} =~ ^[01]$ ]] ||
        die 'Некорректное значение OES_BABL_STANDALONE (ожидается 0 или 1).'
    if [[ ${OES_BABL_STANDALONE:-0} == 1 ]]; then
        profile_root=${CHROME_USER_DATA_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/oes-babl/chrome-profile}
        mkdir -p -m 700 -- "$profile_root"
        [[ ! -L $profile_root && -d $profile_root && -O $profile_root ]] ||
            die "Небезопасный каталог автономного профиля: $profile_root"
    else
        profile_root=${CHROME_USER_DATA_DIR:-${CHROME_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}/google-chrome}
        [[ -d $profile_root ]] || die "Не найден каталог существующего Chrome: $profile_root"
    fi
}

prepare_runtime() {
    local parent=${XDG_RUNTIME_DIR:-} lock
    if [[ -n $parent && ! -L $parent && -d $parent && -O $parent &&
          $(stat -c '%a' -- "$parent") == 700 ]]; then
        runtime_dir=$parent/oes-babl
    else
        runtime_dir=/tmp/oes-babl-$UID
    fi
    # mkdir is atomic. Never follow or chmod a pre-existing shared-/tmp entry.
    if ! mkdir -m 700 -- "$runtime_dir" 2>/dev/null; then
        [[ ! -L $runtime_dir && -d $runtime_dir && -O $runtime_dir &&
           $(stat -c '%a' -- "$runtime_dir") == 700 ]] ||
            die "Небезопасный каталог блокировки: $runtime_dir"
    fi
    lock=$runtime_dir/lock
    [[ ! -L $lock && ( ! -e $lock || ( -f $lock && -O $lock ) ) ]] ||
        die "Небезопасный файл блокировки: $lock"
    exec 9>>"$lock"
    flock -n 9 || die 'Виртуальный экран уже запущен.'
}

profile_in_use() {
    local target pid process=
    target=$(readlink "$1/SingletonLock" 2>/dev/null || true)
    pid=${target##*-}
    [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
    # Inspect argv[0], not arbitrary arguments containing the word "chrome".
    if [[ -r /proc/$pid/cmdline ]]; then
        IFS= read -r -d '' process < "/proc/$pid/cmdline" || true
    fi
    case ${process##*/} in
        ''|chrome|google-chrome|google-chrome-stable) return 0 ;;
        *) return 1 ;;
    esac
}

select_keyboard() {
    local desktop=:${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}:
    local config=${XDG_CONFIG_HOME:-$HOME/.config} detected_layout= detected_options= host_xkb=
    local kde_shortcut= toggle_option=grp:alt_shift_toggle
    desktop=${desktop,,}
    case $desktop in
        *:niri:*)
            if [[ -r $config/niri/config.kdl ]]; then
                detected_layout=$(awk '/^[[:space:]]*layout[[:space:]]+"/ { gsub(/.*layout[[:space:]]+"|".*/, ""); print; exit }' "$config/niri/config.kdl")
                detected_options=$(awk '/^[[:space:]]*options[[:space:]]+"/ { gsub(/.*options[[:space:]]+"|".*/, ""); print; exit }' "$config/niri/config.kdl")
            fi
            ;;
        *:kde:*|*:plasma:*)
            if [[ -r $config/kxkbrc ]]; then
                detected_layout=$(awk -F= '$1 == "LayoutList" { print $2; exit }' "$config/kxkbrc")
                detected_options=$(awk -F= '$1 == "Options" { print $2; exit }' "$config/kxkbrc")
            fi
            if [[ -r $config/kglobalshortcutsrc ]]; then
                kde_shortcut=$(awk -F= '$1 == "Switch to Next Keyboard Layout" { print $2; exit }' "$config/kglobalshortcutsrc")
                case ${kde_shortcut%%,*} in
                    *Alt+Shift*|*Shift+Alt*) toggle_option=grp:alt_shift_toggle ;;
                    *Ctrl+Shift*|*Control+Shift*|*Shift+Ctrl*|*Shift+Control*) toggle_option=grp:ctrl_shift_toggle ;;
                    *Meta+Space*|*Win+Space*|*Space+Meta*|*Space+Win*) toggle_option=grp:win_space_toggle ;;
                    *Alt+Space*|*Space+Alt*) toggle_option=grp:alt_space_toggle ;;
                    *Caps*) toggle_option=grp:caps_toggle ;;
                    *Ctrl+Alt*|*Control+Alt*|*Alt+Ctrl*|*Alt+Control*) toggle_option=grp:ctrl_alt_toggle ;;
                esac
            fi
            ;;
    esac
    if [[ -z $detected_layout && -z ${OES_BABL_LAYOUT:-} ]]; then
        host_xkb=$(xprop -root _XKB_RULES_NAMES 2>/dev/null || true)
        detected_layout=$(awk -F'"' '{print $6}' <<< "$host_xkb")
        detected_options=$(awk -F'"' '{print $10}' <<< "$host_xkb")
    fi
    [[ $detected_layout =~ ^[a-zA-Z0-9_,]+$ ]] || detected_layout=us,ru
    [[ $detected_options =~ ^[a-zA-Z0-9_,:+-]*$ ]] || detected_options=
    xkb_layout=${OES_BABL_LAYOUT:-$detected_layout}
    if [[ $xkb_layout == *,* && $detected_options != *grp:* ]]; then
        detected_options=${detected_options:+$detected_options,}$toggle_option
    fi
    xkb_options=${OES_BABL_XKB_OPTIONS-${detected_options:-$toggle_option}}
    [[ $xkb_layout =~ ^[a-zA-Z0-9_,]+$ ]] || die 'Некорректное значение OES_BABL_LAYOUT.'
    [[ $xkb_options =~ ^[a-zA-Z0-9_,:+-]*$ ]] || die 'Некорректное значение OES_BABL_XKB_OPTIONS.'
}

stop_process() {
    local pid=${1:-} timeout=${2:-20} attempt
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null || return 0
    kill -TERM "$pid" 2>/dev/null || true
    for ((attempt=0; attempt<timeout; attempt++)); do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 0.1
    done
    kill -KILL "$pid" 2>/dev/null || true
}

start_clipboard_bridge() {
    local host_display=${1:-} guest_display=${2:-} guest_auth=${3:-} log_file=${4:-/dev/null}
    clipboard_pid=
    [[ ${OES_BABL_CLIPBOARD:-1} =~ ^[01]$ ]] ||
        die 'Некорректное значение OES_BABL_CLIPBOARD (ожидается 0 или 1).'
    [[ ${OES_BABL_CLIPBOARD:-1} == 1 ]] || return 0
    command -v python3 >/dev/null || return 0
    env -u WAYLAND_DISPLAY GDK_BACKEND=x11 \
        HOST_DISPLAY="$host_display" HOST_XAUTHORITY="${XAUTHORITY:-}" \
        DISPLAY="$guest_display" XAUTHORITY="$guest_auth" \
        python3 -c '
import os, signal, sys
try:
    import gi
    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, Gtk
except Exception:
    sys.exit(0)

guest_disp = Gdk.Display.get_default()
if guest_disp is None:
    sys.exit(0)

host_auth = os.environ.get("HOST_XAUTHORITY", "")
if host_auth:
    os.environ["XAUTHORITY"] = host_auth
else:
    os.environ.pop("XAUTHORITY", None)

host_disp = Gdk.Display.open(os.environ["HOST_DISPLAY"])
if host_disp is None:
    sys.exit(0)

cb_host = Gtk.Clipboard.get_for_display(host_disp, Gdk.SELECTION_CLIPBOARD)
cb_guest = Gtk.Clipboard.get_for_display(guest_disp, Gdk.SELECTION_CLIPBOARD)

def apply_if_changed(_dst_cb, cur_text, payload):
    dst_cb, new_text = payload
    if cur_text != new_text:
        dst_cb.set_text(new_text, -1)
        dst_cb.store()

def on_text(_src_cb, text, dst_cb):
    if text:
        dst_cb.request_text(apply_if_changed, (dst_cb, text))

def on_owner_change(src_cb, _event, dst_cb):
    src_cb.request_text(on_text, dst_cb)

cb_host.connect("owner-change", on_owner_change, cb_guest)
cb_guest.connect("owner-change", on_owner_change, cb_host)
signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
signal.signal(signal.SIGINT, lambda *_: Gtk.main_quit())
Gtk.main()
' >"$log_file" 2>&1 9>&- &
    clipboard_pid=$!
}

# Functions can be loaded by regression tests without starting a desktop session.
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
    return 0
fi

show_help=0
while (( $# > 0 )); do
    case $1 in
        --help|-h) show_help=1; shift ;;
        --grab) OES_BABL_GRAB=1; shift ;;
        --no-grab) OES_BABL_GRAB=0; shift ;;
        --no-clipboard) OES_BABL_CLIPBOARD=0; shift ;;
        --standalone) OES_BABL_STANDALONE=1; shift ;;
        --auto-size) OES_BABL_SIZE=auto; shift ;;
        --) shift; break ;;
        -*) die "Неизвестный параметр: $1" ;;
        *) break ;;
    esac
done

saved_size=
size_file=${XDG_CONFIG_HOME:-$HOME/.config}/oes-babl/screen-size
if [[ -r $size_file ]]; then
    IFS= read -r saved_size < "$size_file" || true
fi
valid_size "$saved_size" || saved_size=1920x1080
size=${OES_BABL_SIZE:-$saved_size}
if [[ $size == auto ]]; then
    size=$(detect_size || printf '%s\n' "$saved_size")
fi

if (( show_help )); then
    printf '%s\n' \
        'Использование: oes-babl [ПАРАМЕТРЫ] [URL]' \
        'Открывает Chrome с обычными профилями на виртуальном экране.' \
        'Экран — на весь монитор; Chrome — с вкладками и адресной строкой.' \
        'Сайт по умолчанию: https://lms.astanait.edu.kz' \
        'Перед запуском полностью выйдите из обычного Chrome (или используйте --standalone).' \
        "Размер экрана: $size (сохранённый при установке: $saved_size)." \
        'Параметры:' \
        '  --standalone     Отдельный профиль Chrome (не требует закрытия основного браузера)' \
        '  --grab           Удерживать курсор и клавиатуру внутри Xephyr (Ctrl+Shift)' \
        '  --no-clipboard   Отключить синхронизацию буфера обмена между хостом и Xephyr' \
        '  --auto-size      Определить текущее разрешение монитора при запуске' \
        '  -h, --help       Показать эту справку' \
        'Переменные окружения:' \
        '  Другой размер: OES_BABL_SIZE=1920x1080 (или auto) oes-babl' \
        '  Раскладки клавиатуры: OES_BABL_LAYOUT=us,ru,kz oes-babl' \
        '  Профиль (необязательно): CHROME_PROFILE="Profile 1" oes-babl'
    exit 0
fi

for dependency in Xephyr openbox xauth xprop mcookie flock; do
    command -v "$dependency" >/dev/null || die "Не найдена программа: $dependency"
done
browser=$(command -v google-chrome-stable || command -v google-chrome || true)
[[ -n $browser ]] || die 'Google Chrome не найден.'
[[ -n ${DISPLAY:-} ]] || die 'Нет DISPLAY. Для Xephyr нужен работающий Xwayland (например, встроенный в KDE/GNOME или xwayland-satellite в niri).'

valid_size "$size" || die 'Размер должен иметь вид 1920x1080 (или auto).'
[[ ${OES_BABL_GRAB:-0} =~ ^[01]$ ]] ||
    die 'Некорректное значение OES_BABL_GRAB (ожидается 0 или 1).'
resolve_profile_root

prepare_runtime
if profile_in_use "$profile_root"; then
    die 'Chrome уже работает. Сохраните работу, выберите в Chrome меню ⋮ → Выход (или используйте --standalone) и запустите oes-babl снова.'
fi

display_number=
for candidate in {99..119}; do
    if [[ ! -e /tmp/.X11-unix/X$candidate && ! -e /tmp/.X$candidate-lock ]]; then
        display_number=$candidate
        break
    fi
done
[[ -n $display_number ]] || die 'Нет свободного номера виртуального экрана (99–119).'
virtual_display=:$display_number
session_dir=$(mktemp -d "$runtime_dir/session.XXXXXXXX")
auth_file=$session_dir/Xauthority
xephyr_pid= wm_pid= clipboard_pid= chrome_pid=

cleanup() {
    trap - EXIT INT TERM HUP
    stop_process "$chrome_pid" 50
    stop_process "$clipboard_pid" 10
    stop_process "$wm_pid" 20
    stop_process "$xephyr_pid" 20
    rm -rf -- "$session_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

select_keyboard

touch "$auth_file"
chmod 600 "$auth_file"
xauth -f "$auth_file" add "$virtual_display" MIT-MAGIC-COOKIE-1 "$(mcookie)"
xephyr_args=(
    "$virtual_display" -screen "$size" -fullscreen -nolisten tcp -noreset
    -title "oes-babl" -xkb-layout "$xkb_layout" -xkb-options "$xkb_options"
    -auth "$auth_file"
)
if [[ ${OES_BABL_GRAB:-0} == 0 ]]; then
    xephyr_args+=(-no-host-grab)
fi
Xephyr "${xephyr_args[@]}" >"$session_dir/xephyr.log" 2>&1 9>&- &
xephyr_pid=$!

ready=false
for ((attempt=0; attempt<100; attempt++)); do
    if ! kill -0 "$xephyr_pid" 2>/dev/null; then
        cat "$session_dir/xephyr.log" >&2
        die 'Не удалось открыть Xephyr.'
    fi
    if [[ -S /tmp/.X11-unix/X$display_number ]] &&
        DISPLAY="$virtual_display" XAUTHORITY="$auth_file" xprop -root >/dev/null 2>&1; then
        ready=true
        break
    fi
    sleep 0.1
done
if [[ $ready != true ]]; then
    cat "$session_dir/xephyr.log" >&2
    die 'Xephyr не запустился за 10 секунд.'
fi

env -u WAYLAND_DISPLAY DISPLAY="$virtual_display" XAUTHORITY="$auth_file" \
    XDG_SESSION_TYPE=x11 openbox >"$session_dir/openbox.log" 2>&1 9>&- &
wm_pid=$!

# Wait for the window manager so Chrome can request maximization reliably.
ready=false
for ((attempt=0; attempt<100; attempt++)); do
    if ! kill -0 "$wm_pid" 2>/dev/null; then
        cat "$session_dir/openbox.log" >&2
        die 'Не удалось запустить Openbox.'
    fi
    wm_state=$(DISPLAY="$virtual_display" XAUTHORITY="$auth_file" \
        xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null || true)
    if [[ $wm_state == *'window id # '* ]]; then
        ready=true
        break
    fi
    sleep 0.1
done
if [[ $ready != true ]]; then
    cat "$session_dir/openbox.log" >&2
    die 'Openbox не запустился за 10 секунд.'
fi

start_clipboard_bridge "$DISPLAY" "$virtual_display" "$auth_file" "$session_dir/clipboard.log"

chrome_args=(--ozone-platform=x11 --disable-background-mode "--user-data-dir=$profile_root" --start-maximized)
[[ -z ${CHROME_PROFILE:-} ]] || chrome_args+=("--profile-directory=$CHROME_PROFILE")
if (( $# == 0 )); then
    set -- https://lms.astanait.edu.kz
fi
printf 'oes-babl: экран %s (%s). Закройте Chrome, чтобы завершить.\n' "$virtual_display" "$size"
if [[ ${OES_BABL_GRAB:-0} == 1 ]]; then
    printf '%s\n' 'Режим захвата ввода включён (переключение курсора и клавиатуры: Ctrl+Shift).'
fi
printf '%s\n' 'Перед записью всего экрана проверьте предпросмотр на сайте.'
env -u WAYLAND_DISPLAY DISPLAY="$virtual_display" XAUTHORITY="$auth_file" \
    XDG_SESSION_TYPE=x11 "$browser" "${chrome_args[@]}" "$@" 9>&- &
chrome_pid=$!
wait "$chrome_pid"
